
import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans

data = [
    [35, 2.4],[22, 0.9],[58, 4.1],[41, 2.8],[19, 0.7],[63, 5.2],[29, 1.5],
    [47, 3.6],[25, 1.8],[52, 3.9],[38, 2.1],[66, 5.5],[31, 1.9],[44, 3.2],
    [21, 0.6],[55, 4.3],[33, 2.5],[60, 4.8],[27, 1.2],[49, 3.7],[40, 2.6],
    [18, 0.5],[57, 4.6],[36, 2.0],[45, 3.4],[24, 1.1],[62, 5.0],[30, 1.7],
    [53, 4.0],[42, 2.9],[20, 0.8],[65, 5.3],[34, 2.2],[48, 3.5],[26, 1.3],
    [59, 4.7],[37, 2.3],[51, 3.8],[23, 1.0],[64, 5.1],[32, 1.8],[46, 3.3],
    [28, 1.4],[56, 4.4],[39, 2.7],[61, 4.9],[43, 3.0],[50, 3.6],[54, 4.2],
    [67, 5.4]
]

Models = KMeans(n_clusters=3, random_state=42)
Models.fit(data)

# Labels
labels = Models.labels_

# Cluster Centers
centers = Models.cluster_centers_

# Plot Data
plt.scatter(
    np.array(data)[:, 0],
    np.array(data)[:, 1],
    c=labels,
    cmap='viridis',
    s=60
)

# Plot Cluster Centers
plt.scatter(
    centers[:, 0],
    centers[:, 1],
    c='red',
    marker='X',
    s=250,
    label='Cluster Centers'
)

plt.xlabel('X')
plt.ylabel('Y')
plt.title('KMeans Clustering')
plt.legend()
plt.grid(True)

plt.show()
